# ---------------------------------------------------------------------------
# Assignment Cover Generator — configuration
#
# Copy to `.env.local` and edit. Every value is optional: with an empty file
# the app still boots and works, it just starts from blank fields.
#
# NEXT_PUBLIC_* values are baked into the browser bundle. Never put a secret
# in one of those. SMTP_* stay server-side only.
# ---------------------------------------------------------------------------

# ---- Institution defaults (seed the form on first load) ----
NEXT_PUBLIC_DEFAULT_UNIVERSITY="Bangladesh University"
NEXT_PUBLIC_DEFAULT_DEPARTMENT="Department of CSE"
NEXT_PUBLIC_DEFAULT_LOGO_URL="/logos/default-logo.svg"
NEXT_PUBLIC_DEFAULT_PROGRAM="B.Sc. in CSE"
NEXT_PUBLIC_DEFAULT_BATCH="68 - Evening"
NEXT_PUBLIC_DEFAULT_SEMESTER="Summer 2025"
NEXT_PUBLIC_DEFAULT_SECTION="B"
NEXT_PUBLIC_DEFAULT_STUDENT_NAME=""
NEXT_PUBLIC_DEFAULT_STUDENT_ID=""

# ---- Look & feel defaults ----
# template:     modern-card | classic-bordered | minimal-rule
# fontPair:     serif | sans | mixed
# dateFormat:   DD/MM/YYYY | MM/DD/YYYY | D MMMM YYYY | YYYY-MM-DD
# watermark:    off | logo | text
NEXT_PUBLIC_DEFAULT_TEMPLATE="modern-card"
NEXT_PUBLIC_DEFAULT_ACCENT="#B91C1C"
NEXT_PUBLIC_DEFAULT_FONT_PAIR="mixed"
NEXT_PUBLIC_DEFAULT_DATE_FORMAT="DD/MM/YYYY"
NEXT_PUBLIC_DEFAULT_PAPER="A4"
NEXT_PUBLIC_DEFAULT_WATERMARK="logo"

# ---- Look & feel, advanced (rarely needed; all tunable in the UI) ----
# margin:       narrow | normal | wide
# density:      compact | normal | airy
# fontScale:    s | m | l
# borderStyle:  none | hairline | solid
# logoPosition: center | left | right
# logoSize:     millimetres, 10–70
NEXT_PUBLIC_DEFAULT_MARGIN="normal"
NEXT_PUBLIC_DEFAULT_DENSITY="normal"
NEXT_PUBLIC_DEFAULT_FONT_SCALE="m"
NEXT_PUBLIC_DEFAULT_BORDER_STYLE="hairline"
NEXT_PUBLIC_DEFAULT_LOGO_POSITION="center"
NEXT_PUBLIC_DEFAULT_LOGO_SIZE="34"

# ---- Behaviour ----
NEXT_PUBLIC_DRAFT_ENABLED_BY_DEFAULT="true"
NEXT_PUBLIC_RESET_DRAFT_AFTER_OUTPUT="true"
NEXT_PUBLIC_FEATURE_EMAIL="true"

# ---- SMTP (server only) ----
# Gmail:  SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_USER=you@gmail.com
#         SMTP_PASS=<16-char app password>   (needs 2FA enabled)
# Brevo:  SMTP_HOST=smtp-relay.brevo.com  SMTP_PORT=587  (300 emails/day free)
# Leaving these blank disables the Email button; everything else keeps working.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Assignment Cover <no-reply@example.com>"
# Emails allowed per IP per hour, per server instance.
RATE_LIMIT_PER_HOUR="5"
